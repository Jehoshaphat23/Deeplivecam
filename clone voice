    async def recv(self):
        """
        Receives a frame from source, processes it and returns a new AudioFrame.
        """
        frame = await self.source.recv()
        # Convert AudioFrame -> numpy array
        samples = frame.to_ndarray()
        # aiortc frames are shape (channels, samples)
        if samples.ndim > 1:
            samples_mono = np.mean(samples, axis=0)
        else:
            samples_mono = samples

        # Normalize to float32 in range -1..1 if needed
        if samples_mono.dtype == np.int16:
            data = samples_mono.astype(np.float32) / 32768.0
        elif samples_mono.dtype == np.int32:
            data = samples_mono.astype(np.float32) / 2**31
        else:
            data = samples_mono.astype(np.float32)

        # Process chunk (placeholder)
        processed = await self.process_frame(data, sr=self.sr)

        # Optional: insert watermark here (TODO)
        # processed = insert_watermark(processed, sr=self.sr)

        # Convert back to int16
        clipped = np.clip(processed, -1.0, 1.0)
        out_int16 = (clipped * 32767.0).astype(np.int16)

        # Recreate AudioFrame. Keep same timestamp / sample_rate info to avoid jitter.
        new_frame = AudioFrame.from_ndarray(out_int16.reshape(1, -1), format="s16", layout="mono")
        new_frame.sample_rate = self.sr
        return new_frame

    async def process_frame(self, data: np.ndarray, sr: int):
        """
        Placeholder processing: pitch-shift the small buffer.
        Replace with streaming voice conversion:
         - feature extraction
         - model.forward(streaming_chunk, speaker_embedding)
         - waveform synthesis (vocoder)
        """
        # Defensive: if silence or tiny chunk, return as-is
        if data.size == 0:
            return data

        # Convert to float64 for librosa
        y = data.astype(np.float32)

        # Simple pitch shift: up 3 semitones (demo). You can expose control via UI.
        n_steps = 3.0

        # librosa expects float32 and a buffer that's not too tiny. If chunk is too small, just return original.
        if y.size < 512:
            return y

        try:
            shifted = librosa.effects.pitch_shift(y, sr=sr, n_steps=n_steps)
        except Exception as e:
            # If pitch shift fails (buffer too small), fallback to original
            print(f"[{self.client_id}] pitch_shift error: {e}")
            return y

        return shifted

    async def stop(self):
        self._stopped = True
        await super().stop()

