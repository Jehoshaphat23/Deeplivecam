        return HTMLResponse(f.read())

@app.post("/offer")
async def offer(request: Request):
    params = await request.json()
    sdp = params["sdp"]
    typ = params["type"]

    pc = RTCPeerConnection()
    PCS.add(pc)
    client_id = str(uuid.uuid4())
    print(f"[{client_id}] New PeerConnection")

    # Keep a reference to transform tracks so they don't get GC'ed
    transform_tracks = []

    @pc.on("iceconnectionstatechange")
    async def on_ice_state_change():
        print(f"[{client_id}] ICE state -> {pc.iceConnectionState}")
        if pc.iceConnectionState == "failed" or pc.iceConnectionState == "closed":
            await pc.close()
            PCS.discard(pc)

    @pc.on("track")
    def on_track(track):
        print(f"[{client_id}] Track received: {track.kind}")
        if track.kind == "audio":
            # Use MediaRelay to allow multiple consumers (if needed)
            local_track = relay.subscribe(track)
            # Create a transform track that reads frames from local_track,
            # applies processing and becomes the outgoing audio track.
            transform = AudioTransformTrack(source_track=local_track, client_id=client_id)
            transform_tracks.append(transform)
            # Add the processed audio as a local outgoing track
            pc.addTrack(transform)

            @track.on("ended")
            async def _ended():
                print(f"[{client_id}] Track ended")
                await transform.stop()

    # set remote description and create answer
    await pc.setRemoteDescription(RTCSessionDescription(sdp=sdp, type=typ))
    answer = await pc.createAnswer()
    await pc.setLocalDescription(answer)

    return JSONResponse({"sdp": pc.localDescription.sdp, "type": pc.localDescription.type, "client_id": client_id})

